PORT=5000

# Cấu hình kết nối MongoDB Atlas (Khuyến nghị cho BTL)
# Thay <username>, <password>, <cluster-url> bằng chuỗi kết nối MongoDB Atlas của bạn
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/travel_journal?retryWrites=true&w=majority

# Cấu hình kết nối MongoDB Local (Mặc định nếu chạy máy có cài MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/travel_journal

JWT_SECRET=supersecretjwtkey_traveljournal_btl_2026
CLIENT_URL=http://localhost:5173
NODE_ENV=development
